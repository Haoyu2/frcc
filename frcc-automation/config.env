# ---------------------------------------------------------------------------
# FRCC automation config
# Source this file in all automation scripts: source "$(dirname "$0")/../config.env"
# ---------------------------------------------------------------------------

# Absolute path to the cloned frcc repo
FRCC_ROOT="${HOME}/Projects/frcc"

# Root directory for all run artifacts (logs, figures, archives)
RUN_ROOT="${HOME}/frcc-runs"

# Conda env name
CONDA_ENV="frcc"

# Path to conda binary (adjust if using mamba or non-default install)
CONDA_BIN="${HOME}/miniconda3/bin/conda"

# Number of parallel experiment workers.
# Rule of thumb: physical_cores / 2. e.g. 8 on a 16-core machine.
N_PROCESSES=8

# Set to 1 to include Copa (genericcc_markovian) in ALL_CCAS.
# Set to 0 to skip Copa (avoids flakiness on some machines).
ENABLE_COPA=1

# Minimum free disk (GB) required before a run starts
MIN_DISK_GB=30

# Minimum free RAM (GB) required before a run starts
# boot.sh mounts a 24G ramdisk so keep headroom
MIN_RAM_GB=28

# Notification email (leave blank to disable)
NOTIFY_EMAIL=""

